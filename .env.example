# AI route. Render production currently uses a Claude OAuth credential in
# ANTHROPIC_API_KEY (agent-sdk). Console API keys (sk-ant-...) also work.
ANTHROPIC_API_KEY=
# Optional secondary auth token if your agent-sdk path needs it
ANTHROPIC_AUTH_TOKEN=
CLAUDE_PROVIDER=anthropic
# Routine telemetry-to-task organization. Keep this on a small, fast model.
CLAUDE_FAST_MODEL=claude-3-5-haiku-latest
# Explicit deep-review and Ask Opus actions only. CLAUDE_MODEL remains a
# backwards-compatible fallback when CLAUDE_DEEP_MODEL is not set.
CLAUDE_DEEP_MODEL=claude-opus-4-8
CLAUDE_MODEL=
CLAUDE_CODE_CLI_PATH=
CLAUDE_CODE_FAST_MODEL=haiku
CLAUDE_CODE_DEEP_MODEL=opus
CLAUDE_CODE_MODEL=opus
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_DEEP_MODEL=deepseek-chat
# Host bind: Render needs 0.0.0.0; local defaults to 127.0.0.1
SENTINEL_HOST=
HOST=
PORT=3000
SENTINEL_INGEST_TOKEN=
SENTINEL_ALLOWED_ORIGINS=
DATABASE_URL=
VITE_PUBLIC_INGEST_BASE_URL=
VITE_SENTINEL_INGEST_TOKEN=
